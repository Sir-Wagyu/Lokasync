<UserControl x:Class="Lokasync.App.Views.TranslationGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="#FFFFFF" BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="6" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Inline Translation Editor &amp; Re-Patch" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,12" />

            <DockPanel Grid.Row="1" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Padding="12,6"
                            Margin="8,0,0,0" />
                    <Button Content="Re-Patch"
                            Command="{Binding RePatchCommand}"
                            Padding="14,6"
                            Margin="8,0,0,0"
                            Background="#0F766E"
                            Foreground="White"
                            FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                    <TextBox Width="260"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5"
                             Margin="0,0,16,0" />
                    <CheckBox Content="FailedValidation Only"
                              IsChecked="{Binding FilterFailedValidationOnly}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="OverflowWarning Only (&gt;25%)"
                              IsChecked="{Binding FilterOverflowWarningOnly}"
                              VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding FilteredEntries}"
                      SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding Status, Converter={StaticResource EntryStatusToBrush}}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Key" Binding="{Binding EntryKey}" IsReadOnly="True" Width="130" />
                    <DataGridTextColumn Header="Source File" Binding="{Binding SourceFile}" IsReadOnly="True" Width="150" />
                    <DataGridTextColumn Header="Original RawText" Binding="{Binding RawText}" IsReadOnly="True" Width="1.2*" />
                    <DataGridTextColumn Header="Editable Text (Preserves [TAG_n]/[VAR_n])"
                                        Binding="{Binding EditedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="1.4*" />
                    <DataGridTextColumn Header="Final Patched Text" Binding="{Binding FinalPatchedText}" IsReadOnly="True" Width="1.2*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="115" />
                    <DataGridCheckBoxColumn Header="Overflow" Binding="{Binding HasOverflowWarning, Mode=OneWay}" IsReadOnly="True" Width="75" />
                    <DataGridTemplateColumn Header="Save" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Save"
                                        Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,2"
                                        Margin="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3"
                    Background="#FEF2F2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,10,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" />
            </Border>

            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="#4B5563" Margin="0,8,0,0" />
        </Grid>
    </Border>
</UserControl>
