<UserControl x:Class="Lokasync.App.Views.GlossaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="#FFFFFF" BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="6" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Narrative Context, Tone &amp; Glossary Manager" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,12" />

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Game Title:" VerticalAlignment="Center" Margin="0,4" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GameTitle, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Genre &amp; Tone:" VerticalAlignment="Top" Margin="0,8,0,4" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding GenreTone, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="64"
                         MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Padding="8,6"
                         Margin="0,4" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Source Term" FontSize="11" Foreground="#4B5563" Margin="0,0,0,2" />
                    <TextBox Text="{Binding NewTermSource, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="Indonesian Target" FontSize="11" Foreground="#4B5563" Margin="0,0,0,2" />
                    <TextBox Text="{Binding NewTermTarget, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                    <TextBlock Text="Note (Optional)" FontSize="11" Foreground="#4B5563" Margin="0,0,0,2" />
                    <TextBox Text="{Binding NewTermNote, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                </StackPanel>
                <Button Grid.Column="3"
                        Content="Add Term"
                        Command="{Binding AddTermCommand}"
                        VerticalAlignment="Bottom"
                        Padding="12,6" />
            </Grid>

            <DataGrid Grid.Row="3"
                      ItemsSource="{Binding GlossaryTerms}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      MinHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="Target" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="Note" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" />
                    <DataGridTemplateColumn Header="Action" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Command="{Binding DataContext.RemoveTermCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,2"
                                        Margin="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <Border Background="#ECFDF5"
                        BorderBrush="#6EE7B7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,6"
                        Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#065F46" TextWrapping="Wrap" />
                </Border>

                <Border Background="#FEF2F2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Auto-Generate Tone &amp; Glossary (AI)"
                        Command="{Binding AutoGenerateCommand}"
                        Padding="14,7"
                        Margin="0,0,10,0"
                        Background="#7C3AED"
                        Foreground="White"
                        FontWeight="SemiBold" />
                <Button Content="Save Narrative Context &amp; Glossary"
                        Command="{Binding SaveGlossaryCommand}"
                        Padding="14,7"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
