<UserControl x:Class="Lokasync.App.Views.RouterProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="#FFFFFF" BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="6" Padding="16">
        <StackPanel>
            <TextBlock Text="Local LLM Router Profile Configuration" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,12" />

            <TextBlock Text="profiles.json Path" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding ProfilesJsonPath, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Reload"
                        Command="{Binding LoadProfilesCommand}"
                        Margin="8,0,0,0"
                        Padding="12,6" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Active Profile:" VerticalAlignment="Center" Margin="0,6" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding AvailableProfileNames}"
                          Text="{Binding ActiveProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Padding="6,4"
                          Margin="0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL (Endpoint):" VerticalAlignment="Center" Margin="0,6" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,5"
                         Margin="0,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Margin="0,6" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,5"
                         Margin="0,4" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="0,6" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,5"
                         Margin="0,4" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Concurrency:" VerticalAlignment="Center" Margin="0,6" />
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding MaxConcurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,5"
                         Margin="0,4" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Delay Between Batches (ms):" VerticalAlignment="Center" Margin="0,6" />
                <TextBox Grid.Row="5" Grid.Column="1"
                         Text="{Binding DelayBetweenBatchesMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,5"
                         Margin="0,4" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Jitter (ms):" VerticalAlignment="Center" Margin="0,6" />
                <TextBox Grid.Row="6" Grid.Column="1"
                         Text="{Binding JitterMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,5"
                         Margin="0,4" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Batch Size:" VerticalAlignment="Center" Margin="0,6" />
                <TextBox Grid.Row="7" Grid.Column="1"
                         Text="{Binding BatchSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,5"
                         Margin="0,4" />
            </Grid>

            <Border Background="#FEF2F2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,12,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="Save Profile"
                        Command="{Binding SaveProfileCommand}"
                        Padding="14,7"
                        Background="#0F766E"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Margin="0,0,8,0" />
                <Button Content="Reset Defaults"
                        Command="{Binding ResetToDefaultsCommand}"
                        Padding="14,7" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
