<UserControl x:Class="Lokasync.App.Views.PipelineControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="#FFFFFF" BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="6" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Translation &amp; Patching Pipeline" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,12" />

            <Border Grid.Row="1"
                    Background="#FFFBEB"
                    BorderBrush="#F59E0B"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsAutoPaused, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Resume Now"
                            Command="{Binding ResumeTranslationCommand}"
                            Padding="12,4"
                            Margin="12,0,0,0"
                            Background="#D97706"
                            Foreground="White"
                            FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AutoPauseBanner}" Foreground="#92400E" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Start"
                        Command="{Binding StartTranslationCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold" />
                <Button Content="Pause"
                        Command="{Binding PauseTranslationCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0" />
                <Button Content="Resume"
                        Command="{Binding ResumeTranslationCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0" />
                <Button Content="Patch Game"
                        Command="{Binding PatchGameCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Background="#0F766E"
                        Foreground="White"
                        FontWeight="SemiBold" />
                <Button Content="Restore Original"
                        Command="{Binding RestoreOriginalCommand}"
                        Padding="14,7"
                        Background="#DC2626"
                        Foreground="White"
                        FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontWeight="Medium" Foreground="#374151" />
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#4B5563">
                        <Run Text="{Binding CompletedCount, Mode=OneWay}" />
                        <Run Text="/" />
                        <Run Text="{Binding TotalCount, Mode=OneWay}" />
                        <Run Text=" (" />
                        <Run Text="{Binding ProgressPercentage, Mode=OneWay, StringFormat=F1}" />
                        <Run Text="%)" />
                    </TextBlock>
                </DockPanel>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage, Mode=OneWay}" Height="18" />
            </StackPanel>

            <Border Grid.Row="4"
                    Background="#FEF2F2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" />
            </Border>

            <GroupBox Grid.Row="5" Header="Live Activity Log">
                <ListBox ItemsSource="{Binding ActivityLogs}"
                         FontFamily="Consolas"
                         FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>
    </Border>
</UserControl>
