<Window x:Class="Lokasync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lokasync.App.Views"
        Title="Lokasync (Lokasync) — Indonesian Game Localization"
        Height="780"
        Width="1260"
        MinHeight="620"
        MinWidth="960"
        Background="#F3F4F6">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111827" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Engine: " Foreground="#9CA3AF" />
                    <TextBlock Text="{Binding Session.DetectedEngine, TargetNullValue=None}"
                               Foreground="#34D399"
                               FontWeight="SemiBold"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Progress: " Foreground="#9CA3AF" />
                    <TextBlock Foreground="#60A5FA" FontWeight="SemiBold">
                        <Run Text="{Binding Pipeline.ProgressPercentage, Mode=OneWay, StringFormat=F1}" />
                        <Run Text="%" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Lokasync" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding Session.GameRootPath}" Foreground="#D1D5DB" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Margin="12" Background="#F9FAFB">
            <TabItem Header="Dashboard &amp; Router">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <views:ProjectDashboardView Grid.Column="0" DataContext="{Binding Dashboard}" />
                        <views:RouterProfileView Grid.Column="2" DataContext="{Binding RouterProfile}" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Glossary &amp; Tone">
                <Grid Margin="12">
                    <views:GlossaryView DataContext="{Binding Glossary}" />
                </Grid>
            </TabItem>

            <TabItem Header="Pipeline &amp; Live Log">
                <Grid Margin="12">
                    <views:PipelineControlView DataContext="{Binding Pipeline}" />
                </Grid>
            </TabItem>

            <TabItem Header="Translation Grid &amp; Re-Patch">
                <Grid Margin="12">
                    <views:TranslationGridView DataContext="{Binding TranslationGrid}" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
